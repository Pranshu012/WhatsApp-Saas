# Frontend Environment Variables (Vite public variables only)
# NEVER put private app secrets, encryption keys, or DB credentials here.

# Backend API Base URL (leave empty in dev to use Vite proxy /api)
VITE_API_BASE_URL=

# Meta Tech Provider App ID (public by design)
VITE_META_APP_ID=123456789012345

# Meta Embedded Signup Configuration ID (public by design)
VITE_META_CONFIG_ID=987654321098765

# Meta Graph API Version
VITE_META_GRAPH_VERSION=v21.0
