[Unit]
Description=WASaaS Web API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=wasaas
Group=wasaas
WorkingDirectory=/opt/wasaas
EnvironmentFile=/etc/wasaas/wasaas.env
Environment=SPRING_PROFILES_ACTIVE=prod,web
ExecStart=/usr/bin/java \
    -XX:+UseG1GC \
    -XX:MaxRAMPercentage=60.0 \
    -Xms256m \
    -Xmx1536m \
    -Djava.security.egd=file:/dev/./urandom \
    -jar /opt/wasaas/releases/current/wasaas.jar

Restart=always
RestartSec=10
LimitNOFILE=65535

# Standard output and error logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wasaas-web

[Install]
WantedBy=multi-user.target
